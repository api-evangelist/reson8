      "name": "Speech to Text",
      "description": {
        "content": "Realtime, turn-level, and prerecorded transcription.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "3496082b-b229-4929-af02-cdbb55727cea",
          "name": "Transcribe a prerecorded audio file",
          "request": {
            "name": "Transcribe a prerecorded audio file",
            "description": {
              "content": "Upload a complete audio file as a binary body and receive the full transcript in one response. Supports diarization, word timing, and pattern recovery via query parameters.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "speech-to-text",
                "prerecorded"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "encoding",
                  "value": "auto",
                  "description": "auto, m4a, m4v, mp4, mov, 3gp, 3g2, pcm_s16le, mulaw, or alaw"
                },
                {
                  "disabled": false,
                  "key": "sample_rate",
                  "value": "16000",
                  "description": "Sample rate in Hz"
                },
                {
                  "disabled": false,
                  "key": "channels",
                  "value": "1",
                  "description": "Number of audio channels"
                },
                {
                  "disabled": false,
                  "key": "language",
                  "value": "<string>",
                  "description": "Language code or comma-separated candidate list (e.g. nl"
                },
                {
                  "disabled": false,
                  "key": "custom_model_id",
                  "value": "<string>",
                  "description": "ID of a custom model to bias transcription"
                },
                {
                  "disabled": false,
                  "key": "include_timestamps",
                  "value": "false"
                },
                {
                  "disabled": false,
                  "key": "include_words",
                  "value": "false"
                },
                {
                  "disabled": false,
                  "key": "include_language",
                  "value": "false"
                },
                {
                  "disabled": false,
                  "key": "include_confidence",
                  "value": "false"
                },
                {
                  "disabled": false,
                  "key": "diarize",
                  "value": "false",
                  "description": "Split the response into per-speaker segments"
                },
                {
                  "disabled": false,
                  "key": "max_speakers",
                  "value": "<number>",
                  "description": "Maximum distinct speakers (only when diarize=true)"
                },
                {
                  "disabled": false,
                  "key": "patterns",
                  "value": "<string>",
                  "description": "Comma-separated regex-style patterns for alphanumeric token recovery"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/octet-stream"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "<binary>"
            }
          },
